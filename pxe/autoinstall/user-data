#cloud-config (reove hostname in identity section to make installation easier)
autoinstall:
  version: 1

  identity:
    username: vagrant
    password: $6$SCzXb6Sse4bODXZF$l5d3KAAW/wBEIbZl1MFuTULPzKhuTvO6PX563KCYpZ9D9ZngBgCTie21I4STtu/E.1Sry4r4iLSCqpU6Y19.o1

  ssh:
    install-server: true
    allow-pw: true

  storage:
    layout:
      name: direct

  network:
    version: 2
    ethernets:
      eth0:
        dhcp4: true

  packages:
    - openssh-server
    - curl

  late-commands:
    - curtin in-target -- systemctl enable ssh
    - curtin in-target -- systemctl start ssh
    - curtin in-target -- touch /etc/pxe-installed
    - |
      MAC=$(ip -o link show | awk -F'link/ether ' '/ether/ {print $2; exit}')
      curl -sf -X POST -H "Content-Type: application/json" \
        -d "{\"mac\":\"${MAC}\"}" \
        http://10.20.30.1:8080/install-complete

  shutdown: reboot